@model AccountFormViewModel
@{
    ViewData["Title"] = "Edit account";
}

<h1 class="h3 mb-4">Edit account</h1>

<form method="post" asp-action="Edit" class="card shadow-sm col-lg-6">
    <div class="card-body">
        <partial name="_AccountForm" model="Model" />
        <button class="btn btn-success">Save</button>
        <a class="btn btn-link link-success" asp-controller="Dashboard" asp-action="Index">Cancel</a>
    </div>
</form>
