@model CampusViewModel
@{
    ViewData["Title"] = "Campus";
}

<h1 class="h3 mb-4">Campus</h1>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-success text-white fw-semibold">Current violations</div>
    @if (!Model.Violations.Any())
    {
        <div class="card-body text-muted">No open violations.</div>
    }
    else
    {
        <table class="table table-striped mb-0">
            <thead><tr><th>Date</th><th>Violation</th><th>Details</th></tr></thead>
            <tbody>
                @foreach (var v in Model.Violations)
                {
                    <tr><td>@v.Date.ToString("MMM d, yyyy")</td><td>@v.Title</td><td>@v.Description</td></tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-success text-white fw-semibold">Missing clearances</div>
    @if (!Model.MissingClearances.Any())
    {
        <div class="card-body text-muted">Nothing missing.</div>
    }
    else
    {
        <table class="table table-striped mb-0">
            <thead><tr><th>Clearance</th><th>Guide</th></tr></thead>
            <tbody>
                @foreach (var r in Model.MissingClearances)
                {
                    <tr><td>@r.Name</td><td>@r.Guide</td></tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="card shadow-sm">
    <div class="card-header bg-success text-white fw-semibold">Campus objectives: missing</div>
    @if (!Model.MissingObjectives.Any())
    {
        <div class="card-body text-muted">All objectives complete.</div>
    }
    else
    {
        <table class="table table-striped mb-0">
            <thead><tr><th>Objective</th><th>Guide</th></tr></thead>
            <tbody>
                @foreach (var r in Model.MissingObjectives)
                {
                    <tr><td>@r.Name</td><td>@r.Guide</td></tr>
                }
            </tbody>
        </table>
    }
</div>
