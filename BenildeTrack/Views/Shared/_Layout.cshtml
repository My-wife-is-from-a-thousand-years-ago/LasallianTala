@* FIX (UI):
     - Sidebar fills the full screen height and stays in place when scrolling.
     - Page content is capped at 1400px wide so cards don't stretch on wide screens.
     - Login/register card is centered, narrower, with smaller headings and green buttons/links.
     - The empty "Use another service to log in" column is removed no matter which Bootstrap
       class .NET uses for it (the old script looked for class names this .NET version doesn't use). *@
@inject IWebHostEnvironment Env
@{
    var current = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";

    // Bootstrap classes for one sidebar link. The active page gets a white pill with green text.
    string NavClass(params string[] controllers) =>
        controllers.Contains(current) ? "nav-link active bg-white text-success fw-semibold" : "nav-link text-white";

    var navTala = NavClass("Tala");
    var navDashboard = NavClass("Dashboard", "Campus", "Attendance", "Students", "Subjects", "Excuses", "Accounts");
    var navHandbook = NavClass("Handbook");
    var navProfile = NavClass("Profile");

    bool signedIn = User.Identity?.IsAuthenticated == true;
    string role = User.IsInRole(AppRoles.Admin) ? "Admin" : User.IsInRole(AppRoles.Professor) ? "Professor" : "Student";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @AppInfo.Name</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        /* Sidebar: full screen height on tablets and up, and it stays put while the page scrolls. */
        @@media (min-width: 768px) {
            .app-sidebar { position: sticky; top: 0; height: 100vh; overflow-y: auto; }
        }
        .app-sidebar .nav-link:not(.active):hover { background-color: rgba(255, 255, 255, .15); }

        /* Login / register card: the built-in pages use big headings meant for a full page. Tone them down. */
        .auth-card h1 { font-size: 1.5rem; margin-bottom: 1rem; }
        .auth-card h2, .auth-card hr { display: none; }
        .auth-card .btn-primary { background-color: var(--bs-success); border-color: var(--bs-success); }
        .auth-card a { color: var(--bs-success); }
    </style>
</head>
<body class="bg-light">
@if (signedIn)
{
    @* Logged in: green sidebar on the left, page on the right. Same sidebar for every role. *@
    <div class="container-fluid">
        <div class="row min-vh-100">
            <nav class="app-sidebar col-12 col-md-3 col-lg-2 bg-success text-white d-flex flex-column p-3">
                <a class="fs-4 fw-bold text-white text-decoration-none mb-4" asp-controller="Tala" asp-action="Index">@AppInfo.Name</a>

                <ul class="nav nav-pills flex-column gap-1">
                    <li class="nav-item"><a class="@navTala" asp-controller="Tala" asp-action="Index">Ask Tala</a></li>
                    <li class="nav-item"><a class="@navDashboard" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li class="nav-item"><a class="@navHandbook" asp-controller="Handbook" asp-action="Index">Handbook</a></li>
                    <li class="nav-item"><a class="@navProfile" asp-controller="Profile" asp-action="Index">Profile</a></li>
                </ul>

                <div class="mt-auto pt-4 border-top border-light border-opacity-25">
                    <div class="small text-truncate mb-1">@User.Identity?.Name</div>
                    <span class="badge bg-light text-success mb-3">@role</span>
                    <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                        <button type="submit" class="btn btn-outline-light btn-sm w-100">Log out</button>
                    </form>
                </div>
            </nav>

            <main class="col-12 col-md-9 col-lg-10 p-4">
                @* Caps the width so cards don't stretch across very wide screens. *@
                <div class="mx-auto" style="max-width: 1400px">
                    @* One place for the messages controllers leave in TempData. *@
                    @if (TempData["Message"] != null)
                    {
                        <div class="alert alert-success">@TempData["Message"]</div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">@TempData["Error"]</div>
                    }

                    @RenderBody()
                </div>
            </main>
        </div>
    </div>
}
else
{
    @* Logged out: login and register pages appear in a centered card. *@
    <div class="container d-flex flex-column justify-content-center min-vh-100 py-5">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">
                <div class="card shadow-sm border-0 auth-card">
                    <div class="card-header bg-success text-white fs-4 fw-bold text-center py-3">@AppInfo.Name</div>
                    <div class="card-body p-4">
                        @RenderBody()
                    </div>
                </div>

                @if (Env.IsDevelopment())
                {
                    <div class="alert alert-light border small mt-3">
                        <strong>Demo accounts</strong> (development only). Password: <code>Demo@12345</code><br />
                        admin@demo.test, prof@demo.test, ana@demo.test, ben@demo.test
                    </div>
                }
            </div>
        </div>
    </div>

    <script>
        // The built-in login/register pages put the form in one column and an empty "external login" column
        // beside it. The column class names change between .NET versions (col-md-4, col-lg-6, ...), so instead of
        // matching names: keep the first column of each row, remove the others, and make the first one full width.
        document.querySelectorAll(".auth-card .card-body .row").forEach(row => {
            const columns = Array.from(row.children).filter(child => /\bcol(-|\b)/.test(child.className));
            if (columns.length < 2) return;
            columns.slice(1).forEach(column => column.remove());
            columns[0].className = "col-12";
        });
    </script>
}

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/live-search.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>