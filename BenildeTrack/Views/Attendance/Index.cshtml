@model AttendanceViewModel
@{
    ViewData["Title"] = "Attendance";
    var today = DateTime.Today.ToString("yyyy-MM-dd");
    var students = Model.Roster.Select(r => r.Student).ToList();
}

<h1 class="h3 mb-4">@Model.Subject.Code - @Model.Subject.Name</h1>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-success text-white fw-semibold">Record absence or late</div>
    <div class="card-body">
        <form method="post" asp-action="Add" class="row g-2">
            <input type="hidden" name="subjectId" value="@Model.Subject.Id" />
            <div class="col-md-4">
                <select name="studentId" class="form-select" asp-items="@(new SelectList(students, "Id", "DisplayName"))"></select>
            </div>
            <div class="col-md-3">
                <input type="date" name="date" class="form-control" value="@today" />
            </div>
            <div class="col-md-3">
                <select name="type" class="form-select">
                    <option value="Absent">Absent (@AttendanceRecord.AbsentPoints pts)</option>
                    <option value="Late">Late (@AttendanceRecord.LatePoints pt)</option>
                </select>
            </div>
            <div class="col-md-2">
                <button class="btn btn-success w-100">Add</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-success text-white fw-semibold">Class roster</div>
    <table class="table table-striped align-middle mb-0">
        <thead><tr><th>Student</th><th>Absences</th><th>Lates</th><th>Dropout points</th></tr></thead>
        <tbody>
            @foreach (var r in Model.Roster)
            {
                var color = SubjectPoints.ColorOf(SubjectPoints.PercentOf(r.Points, Model.Subject.MaxPoints));
                <tr>
                    <td>@r.Student.DisplayName</td>
                    <td>@r.Absences</td>
                    <td>@r.Lates</td>
                    <td><span class="badge bg-@color">@r.Points / @Model.Subject.MaxPoints</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-success text-white fw-semibold">Recent records</div>
    @if (!Model.Recent.Any())
    {
        <div class="card-body text-muted">Nothing recorded yet.</div>
    }
    else
    {
        <table class="table table-striped align-middle mb-0">
            <thead><tr><th>Date</th><th>Student</th><th>Type</th><th></th></tr></thead>
            <tbody>
                @foreach (var r in Model.Recent)
                {
                    <tr>
                        <td>@r.Date.ToString("MMM d, yyyy")</td>
                        <td>@r.Student?.DisplayName</td>
                        <td>@r.Type</td>
                        <td class="text-end">
                            <form method="post" asp-action="Remove">
                                <input type="hidden" name="subjectId" value="@Model.Subject.Id" />
                                <input type="hidden" name="recordId" value="@r.Id" />
                                <button class="btn btn-sm btn-outline-danger">Remove</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<a class="link-success d-inline-block mt-3" asp-controller="Dashboard" asp-action="Index">Back to dashboard</a>
